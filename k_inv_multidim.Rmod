##############################
# Simple multi-dimensional capital accumulation
#
# Philip Schuster, October 2026
##############################

#-------------------------------------------------------------------------------

dim:

  tt = 1:600
  j  = 1:2
  k  = 1:2

#-------------------------------------------------------------------------------

model:

  K|predet: K[j,k,tt+1] = Inv[j,tt] + (1-delta[j])*K[j,k,tt]           | j = 1:2 | k = 1:2
    
  X: X[tt] = 100.0                                    # trivial equation
  Y: Y[tt] = rho * Y[tt-1] + (1-rho) * K[1,1,tend]    # use final steady value in model equations
  Z: Z[j,k,tt] = 4 * K[j,k,tend] | j = 1:2 | k = 1:2  # use multidim final steady values in model equations
  Q: Q[j,tt] = 3 * K0[j,1] | j = 1:2                  # use multidim calibration values in model equations

#-------------------------------------------------------------------------------

calib:

  delta[1] = 0.03
  delta[2] = 0.035
  Inv0[j]  = 0.4  | j = 1:2
  rho      = 0.9
  alpha    = 0.4 # unnecessary parameter

#-------------------------------------------------------------------------------

startguess:

  K0[1,1]    = 21
  K0[2,1]    = 30
  #K0[1,2]    = 20   # using default guess for one element
  K0[2,2]    = 25
  foo        = 2.0   # unnecessary startguess

#-------------------------------------------------------------------------------

run:

  calib()

  Inv[1,]  = Inv[1,]*0+0.5
  Inv[2,]  = Inv[2,]*0+0.65
  K[2,2,1] = K0[2,2]*0.95
  K[1,1,1] = K0[1,1]*0.97

  dynsolve()

  # plot(1:tend, K[1, 1,], type = "l", ylim = c(15, 40))
  # lines(1:tend, K[2, 1,], col = "blue")
  # lines(1:tend, K[1, 2,], col = "red")
  # lines(1:tend, K[2, 2,], col = "green")

#######################

