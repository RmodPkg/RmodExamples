################################################################################
# Bank portfolio problem
# - with quadratic holding costs
# - with quadratic adjustment costs
# - with bounds on asset holdings/loans
#
# Philip Schuster, April 2025

# Easy example (2 loans and 1 deposit)

# Pi[tt] = p1[tt]*X1[tt] - phi1/2*X1[tt]^2 - chi1/2*(X1[tt]-X1[tt-1])^2
#        + p2[tt]*X2[tt] - phi2/2*X2[tt]^2 - chi2/2*(X2[tt]-X2[tt-1])^2
#        + p3[tt]*X3[tt] - phi3/2*X3[tt]^2 - chi3/2*(X3[tt]-X3[tt-1])^2
#        - p4[tt]*X4[tt] - phi4/2*X4[tt]^2 - chi4/2*(X4[tt]-X4[tt-1])^2
#        + betta*Pi[tt+1]
#
# s.t.
# X1[tt] + X2[tt] + X3[tt] = X4[tt]/mu
#
#
# Strategy: eliminate X4[tt] before computing FOCs

################################################################################

dims:

  tt = 1:300


model:

  temp := mu*(-p4[tt] - phi4*X4[tt] - chi4*(X4[tt] - X4[tt-1]) + betta*chi4*(X4[tt+1] - X4[tt]))

  X1 | bounds[0, Inf]: p1[tt] - phi1*X1[tt] - chi1*(X1[tt] - X1[tt-1]) + betta*chi1*(X1[tt+1] - X1[tt]) + temp = 0

  X5: X5[tt] = 3.0*X1[tt]

  X2 | bounds[-10, Inf]: p2[tt] - phi2*X2[tt] - chi2*(X2[tt] - X2[tt-1]) + betta*chi2*(X2[tt+1] - X2[tt]) + temp = 0

  X3 | bounds[0, Inf]: p3[tt] - phi3*X3[tt] - chi3*(X3[tt] - X3[tt-1]) + betta*chi3*(X3[tt+1] - X3[tt]) + temp = 0

  X4: X1[tt] + X2[tt] + X3[tt] = X4[tt]/mu

################################################################################

calib:

  betta = 0.9
  mu    = 1/(1-0.1) # inverse of (1 - reserve rate)

  p10   = 5.0
  phi1  = 0.2
  chi1  = 0.1

  #p20: X20 = 5.0
  p20   = 4.5
  phi2  = 0.1
  chi2  = 0.1

  p30   = 4.5
  phi3  = 0.2
  chi3  = 0.2

  p40   = 2.0
  phi4  = 0.3
  chi4  = 0.1


################################################################################

run:

  calib(verbose = "full")

  ### first shock ###
  p1 = p1*1.2
  p2 = p2*0.9

  dynsolve(starttime = 1, verbose = "full")

  # plot(0:tend, c(X10,X1), type="l", xlim=c(0,50))
  # plot(0:tend, c(X20,X2), type="l", xlim=c(0,50))
  # plot(0:tend, c(X30,X3), type="l", xlim=c(0,50))
  # plot(0:tend, c(X40,X4), type="l", xlim=c(0,50))

  ### new shock ###
  p3[20:tend] = p3[20:tend]*2
  # p3 = p3*2

  dynsolve(starttime = 20, verbose = "full")
  # dynsolve(verbose = "full")

  # plot(0:tend, c(X10,X1), type="l", xlim=c(0,50))
  # plot(0:tend, c(X20,X2), type="l", xlim=c(0,50))
  # plot(0:tend, c(X30,X3), type="l", xlim=c(0,50))
  # plot(0:tend, c(X40,X4), type="l", xlim=c(0,50))

