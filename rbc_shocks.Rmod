##############################
# A simple RBC model with labor and capital
# - using shock lists
# Philip Schuster, September 2026
##############################
#-------------------------------------------------------------------------------

model:

  L: -U_L[tt]/U_C[tt] = Y_L[tt]

  Cons: U_C[tt]/U_C[tt+1] = betta*(Y_K[tt+1] + 1 - delta)

  K|predet: K[tt+1] = Y[tt] - Cons[tt] + (1-delta)*K[tt]

#-------------------------------------------------------------------------------

func:

  Y   = function(TFP, K, L) TFP * K^alpha * L^(1-alpha)
  Y_L = partial(Y, L)
  Y_K = partial(Y, K)

  U   = function(Cons, L) ( if (sigC == 1) log(Cons) else (Cons^(1-1/sigC)-1)/(1-1/sigC) ) - psi*L^(1+sigL)/(1+sigL)
  U_C = partial(U, Cons)
  U_L = partial(U, L)

#-------------------------------------------------------------------------------

preproc:

  U@x@s = U@x(Cons@s, L@s)              | @s = 0, [tt], [tt+1] | @x = , _C, _L
  Y@x@s = Y@x(TFP@s, K@s, L@s)          | @s = 0, [tt], [tt+1] | @x = , _K, _L

#-------------------------------------------------------------------------------

calib:

  betta = 0.99
  sigC  = 0.8
  sigL  = 1.2
  alpha = 0.35

  delta: delta = 0.2*Y0/K0
  psi:   L0 = 0.7
  TFP0: Y0 = 1.0

#-------------------------------------------------------------------------------

run:

  # calibration
  calib()

  set.seed(123)

  shocklist = list()
  shocklist = shock_add(shocklist, var = "TFP", values = TFP0 * rep(0.02, 30))
  shocklist = shock_add(shocklist, var = "TFP", values = TFP0 * rep(0.02, 20), starttime = 10)
  shocklist = shock_unknown(shocklist, var = "TFP", values = TFP0 * seq(from = 0.01, to = 0.02, length.out = 10), starttime = 30)
  shocklist = shock_imp(shocklist, var = "TFP", rho = 0.97, sd = TFP0 * 0.02)
  shocklist = shock_stoch(shocklist, var = "TFP", rho = 0.97, sd = TFP0 * 0.02, periods = 50)

  extendpath(shocklist)

  plot(0:tend, c(TFP0, TFP), type = "l", xlim = c(0, 50))

#######################








